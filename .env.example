APP_NAME="Дом в срок"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dom.example.ru
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

SERVER_NAME=:80

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dom
DB_USERNAME=dom
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array

# MAX Bot API
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE=https://platform-api2.max.ru
# polling локально, webhook в проде
MAX_MODE=polling
MAX_WEBHOOK_SECRET=
MAX_MINIAPP_URL="${APP_URL}/app"
MAX_INIT_DATA_TTL=86400
# если без докера, сюда сертификат минцифры
# MAX_CA_BUNDLE=docker/certs/russian_trusted_root_ca.crt

FILESYSTEM_DISK=private
ATTACHMENT_MAX_MB=10

# тест данные и учётки для проверки
DEMO_SEED=true
DEMO_ACCOUNTS_ENABLED=true
# /dispatcher <код> в боте выдаёт роль диспетчера демо-организации
DEMO_ACCESS_CODE=
DEMO_DISPATCHER_PASSWORD=
DEMO_RESIDENT_PASSWORD=
SANCTUM_EXPIRATION=720

VITE_APP_NAME="${APP_NAME}"
