<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- тесты на реальном постгресе, хост и пользователь из .env или из ci -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="dom_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAX_BOT_TOKEN" value="test-bot-token"/>
        <env name="MAX_WEBHOOK_SECRET" value="test-webhook-secret"/>
        <env name="MAX_MODE" value="polling"/>
        <env name="MAX_BOT_USERNAME" value="test_bot"/>
        <env name="DEMO_SEED" value="true"/>
        <env name="SPEC_PATH" value="docs"/>
        <env name="DEMO_ACCOUNTS_ENABLED" value="true"/>
        <env name="DEMO_ACCESS_CODE" value="TEST-CODE"/>
        <env name="DEMO_DISPATCHER_PASSWORD" value="dispatcher-pass"/>
        <env name="DEMO_RESIDENT_PASSWORD" value="resident-pass"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
