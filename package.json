{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint resources/js --max-warnings=0",
        "format": "prettier --write resources/js",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "api:types": "openapi-typescript docs/openapi.yaml -o resources/js/miniapp/api/schema.d.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.0",
        "laravel-vite-plugin": "^3.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.7",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.1"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@maxhub/max-ui": "^0.5.0",
        "@tanstack/react-query": "^5.103.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^7.18.4"
    },
    "name": "dom-v-srok"
}
